<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apriltag_localization</name>
  <version>0.1.0</version>
  <description>D435 AprilTag 绝对地标重定位，广播理想地图到雷达 odom 的校正 TF 并发布校正后的 Odometry。</description>
  <maintainer email="todo@todo.todo">AT_sim2real</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>robot_msgs</depend>
  <depend>libopencv-dev</depend>

  <!-- 下面两个第三方 SDK 不作为 rosdep 依赖声明（各发行版 rosdep key 不一致），
       安装方法见本包 teach.md 的「1. 依赖安装」：
       librealsense2-dev (librealsense2) 与 apriltag (libapriltag-dev / 源码编译) -->
  <!-- <depend>librealsense2-dev</depend> -->
  <!-- <depend>apriltag</depend> -->

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

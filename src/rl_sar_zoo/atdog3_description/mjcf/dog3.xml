    <mesh name="right_front4" file="right_front4.stl"/>
    <mesh name="left_behind1" file="left_behind1.stl"/>
    <mesh name="left_behind2" file="left_behind2.stl"/>
    <mesh name="left_behind3" file="left_behind3.stl"/>

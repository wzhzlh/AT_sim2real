<mujoco model="dog3">
  <compiler angle="radian" meshdir="assets" autolimits="true" />

  <option cone="elliptic" impratio="100" />

  <default>
    <default class="dog3">
      <geom type="mesh" contype="1" conaffinity="1" group="2" />
      <joint damping="0.1" armature="0.01" frictionloss="0.2" />
      <motor ctrlrange="-23.5 23.5" />
    </default>
  </default>

  <asset>
    <mesh name="base_link" file="base_link.stl"/>
    <mesh name="left_front1" file="left_front1.stl"/>
    <mesh name="left_front2" file="left_front2.stl"/>
    <mesh name="left_front3" file="left_front3.stl"/>
    <mesh name="left_front4" file="left_front4.stl"/>
    <mesh name="right_front1" file="right_front1.stl"/>

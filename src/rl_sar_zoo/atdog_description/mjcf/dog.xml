      <contact>
      <!-- 躯干与各腿近端零件 -->
      <exclude body1="base_link" body2="FL_hip" />
      <exclude body1="base_link" body2="FL_thigh" />
      <exclude body1="base_link" body2="FR_hip" />
      <exclude body1="base_link" body2="FR_thigh" />
      <exclude body1="base_link" body2="RL_hip" />
      <exclude body1="base_link" body2="RL_thigh" />
      <exclude body1="base_link" body2="RR_hip" />
      <exclude body1="base_link" body2="RR_thigh" />

      <!-- 同一条腿相邻连杆 -->
      <exclude body1="FL_hip" body2="FL_thigh" />
      <exclude body1="FL_thigh" body2="FL_calf" />
      <exclude body1="FL_calf" body2="FL_foot" />

      <exclude body1="FR_hip" body2="FR_thigh" />
      <exclude body1="FR_thigh" body2="FR_calf" />
      <exclude body1="FR_calf" body2="FR_foot" />

      <exclude body1="RL_hip" body2="RL_thigh" />
      <exclude body1="RL_thigh" body2="RL_calf" />
      <exclude body1="RL_calf" body2="RL_foot" />

      <exclude body1="RR_hip" body2="RR_thigh" />
      <exclude body1="RR_thigh" body2="RR_calf" />
      <exclude body1="RR_calf" body2="RR_foot" />

      <!-- 同一条腿非相邻但运动时容易穿模 -->
      <exclude body1="FL_hip" body2="FL_calf" />
      <exclude body1="FL_thigh" body2="FL_foot" />

      <exclude body1="FR_hip" body2="FR_calf" />
      <exclude body1="FR_thigh" body2="FR_foot" />

      <exclude body1="RL_hip" body2="RL_calf" />
      <exclude body1="RL_thigh" body2="RL_foot" />

      <exclude body1="RR_hip" body2="RR_calf" />
      <exclude body1="RR_thigh" body2="RR_foot" />

      <!-- 四个髋部之间 -->
      <exclude body1="FL_hip" body2="FR_hip" />
      <exclude body1="FL_hip" body2="RL_hip" />
      <exclude body1="FL_hip" body2="RR_hip" />
      <exclude body1="FR_hip" body2="RL_hip" />
      <exclude body1="FR_hip" body2="RR_hip" />
      <exclude body1="RL_hip" body2="RR_hip" />

      <!-- 前后腿靠近躯干处可能接触 -->
      <exclude body1="FL_thigh" body2="FR_thigh" />
      <exclude body1="RL_thigh" body2="RR_thigh" />
    </contact>



    <mesh name="left_front3" file="left_front3.STL"/>
    <mesh name="left_front4" file="left_front4.STL"/>
    <mesh name="right_front1" file="right_front1.STL"/>
    <mesh name="right_front2" file="right_front2.STL"/>
    <mesh name="right_front3" file="right_front3.STL"/>
    <mesh name="right_front4" file="right_front4.STL"/>
    <mesh name="left_behind1" file="left_behind1.STL"/>
    <mesh name="left_behind2" file="left_behind2.STL"/>
